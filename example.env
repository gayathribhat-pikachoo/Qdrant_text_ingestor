QDRANT_HOST=localhost
QDRANT_PORT=6333
# Set true to use gRPC for data operations (Docker must publish 6334). URL stays http://host:6333.
QDRANT_PREFER_GRPC=false
QDRANT_GRPC_PORT=6334
# Client HTTP/gRPC deadline in seconds (raise for large upserts / slow networks; library default is 5s if omitted)
QDRANT_TIMEOUT=300
QDRANT_VECTOR_SIZE=3072
QDRANT_SHARDS_PER_TENANT=1
QDRANT_REPLICATION_FACTOR=1
QDRANT_TENANT_ID_FIELD=tenant_id
QDRANT_FORCE_RECREATE_COLLECTIONS=false